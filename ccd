#!/usr/bin/env bash
# ccd [N] [claude args...] — run Claude Code as profile N.
# Profile 1 is plain `claude`. Profile N > 1 is ~/.claude-profile-N: its own login,
# everything else shared with ~/.claude through symlinks.
set -euo pipefail

base="$HOME/.claude"
shared=(projects history.jsonl file-history CLAUDE.md hooks settings.json plugins skills rules agents commands)

n=1
if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    n=$((10#$1))
    shift
fi

reset=0
if [[ "${1:-}" == --reset-auth ]]; then
    reset=1
    shift
fi

((n > 1 || ! reset)) || { echo "ccd: --reset-auth needs a profile number above 1" >&2; exit 1; }

# shellcheck disable=SC2086
((n <= 1)) && exec claude ${CCD_ARGS:-} "$@"

dir="$HOME/.claude-profile-$n"

# list_models URL KEY SECONDS: set $ids to the model IDs at URL, one per line. On failure,
# return 1 with the reason in $code.
list_models() {
    local body kcfg
    body=$(mktemp)
    # Sent the way Claude Code will send it (both headers), on stdin so `ps` never sees it.
    kcfg=${2//\\/\\\\}
    kcfg=${kcfg//\"/\\\"}
    code=$(curl -sS -m "$3" -o "$body" -w '%{http_code}' -K - "$1/v1/models?limit=1000" \
        <<<"header = \"x-api-key: $kcfg\"
header = \"authorization: Bearer $kcfg\"
header = \"anthropic-version: 2023-06-01\"") || code=000
    if [[ "$code" == 200 ]]; then
        if command -v jq >/dev/null; then
            jq -e '.data | type == "array"' "$body" >/dev/null 2>&1 || code="200, but not a model list"
        else
            grep -q '"data"' "$body" || code="200, but not a model list"
        fi
    fi
    if [[ "$code" != 200 ]]; then
        rm -f "$body"
        return 1
    fi
    if command -v jq >/dev/null; then
        ids=$(jq -r '.data[]?.id // empty' "$body" 2>/dev/null)
    else
        ids=$(grep -o '"id" *: *"[^"]*"' "$body" | cut -d'"' -f4)
    fi
    rm -f "$body"
}

# Ask how a new profile signs in. Regular leaves it to /login. API sets $api_key and $api_env
# (URL and model as KEY=VALUE lines), once the endpoint answers and its models are listed.
ask_auth() {
    local mode url key models m pick i
    while :; do
        read -rp "Sign in via [1] regular (/login) or [2] API? [1] " mode
        [[ "${mode:-1}" == 2 ]] || return 0
        command -v curl >/dev/null || { echo "ccd: API sign-in needs curl, using regular" >&2; return 0; }
        read -rp "Base URL [https://api.anthropic.com]: " url
        url="${url:-https://api.anthropic.com}"
        url="${url%/}"
        url="${url%/v1}"
        [[ "$url" != http://* ]] || echo "ccd: warning, http:// sends your key unencrypted" >&2
        read -rsp "API key: " key
        echo
        [[ -n "$key" ]] || { echo "ccd: no key given, starting over" >&2; continue; }

        echo "Testing connection..." >&2
        if ! list_models "$url" "$key" 20; then
            echo "ccd: connection failed (HTTP $code), starting over" >&2
            continue
        fi
        models=()
        while IFS= read -r m; do
            if [[ -n "$m" ]]; then models+=("$m"); fi
        done <<<"$ids"

        echo "Connected." >&2
        pick=""
        if ((${#models[@]})); then
            for i in "${!models[@]}"; do echo "  $((i + 1))) ${models[i]}" >&2; done
            while :; do
                read -rp "Default model (number or name, enter to skip): " pick
                if [[ ! "$pick" =~ ^[0-9]+$ ]]; then break; fi
                if ((10#$pick >= 1 && 10#$pick <= ${#models[@]})); then
                    pick="${models[10#$pick - 1]}"
                    break
                fi
                echo "ccd: no model number $pick" >&2
            done
        fi
        api_key="$key"
        api_env="ANTHROPIC_BASE_URL=$url"$'\n'
        if [[ -n "$pick" ]]; then api_env+="ANTHROPIC_MODEL=$pick"$'\n'; fi
        return 0
    done
}

api_key=""
api_env=""
write_api() {
    if [[ -n "$api_key" ]]; then
        (umask 077 && printf '%s' "$api_key" >"$dir/ccd.key" && printf '%s' "$api_env" >"$dir/ccd.env")
    fi
}

# Ask again for a profile that already exists. Regular removes the API files, so /login applies.
if ((reset)); then
    [[ -d "$dir" ]] || { echo "ccd: profile $n does not exist" >&2; exit 1; }
    [[ -t 0 && -t 1 ]] || { echo "ccd: --reset-auth needs a terminal" >&2; exit 1; }
    ask_auth
    rm -f "$dir/ccd.key" "$dir/ccd.env" "$dir/ccd.models"
    write_api
fi

if [[ ! -d "$dir" ]]; then
    [[ -t 0 && -t 1 ]] && ask_auth
    echo "ccd: creating profile $n in $dir" >&2
    mkdir -p "$dir"
    write_api

    # User-scope MCP servers live in .claude.json, which is per profile. Seed the new one
    # from whichever of profile 1's files is in use; Claude Code fills in the rest.
    src="$HOME/.claude.json"
    [[ "$base/.claude.json" -nt "$src" ]] && src="$base/.claude.json"
    if [[ ! -f "$src" ]]; then
        :
    elif command -v jq >/dev/null; then
        (umask 077 && jq '{mcpServers: (.mcpServers // {})}' "$src" >"$dir/.claude.json")
    else
        echo "ccd: jq not found, MCP servers not copied to profile $n" >&2
    fi
fi

# Every start, so items added to ~/.claude later are picked up.
for f in "${shared[@]}"; do
    if [[ -e "$base/$f" && ! -e "$dir/$f" && ! -L "$dir/$f" ]]; then
        ln -s "$base/$f" "$dir/$f"
    fi
done

# API profiles keep the key in ccd.key and the URL and model in ccd.env. The key reaches Claude
# Code through apiKeyHelper, so it never sits in the environment of hooks and tools. Variables
# from the parent shell must not override the profile. ccd.env is read as data, never sourced.
if [[ -f "$dir/ccd.key" ]]; then
    unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_MODEL
    if [[ -f "$dir/ccd.env" ]]; then
        while IFS='=' read -r k v || [[ -n "$k" ]]; do
            v=${v%$'\r'}
            case "$k" in ANTHROPIC_BASE_URL | ANTHROPIC_MODEL) export "$k=$v" ;; esac
        done <"$dir/ccd.env"
    fi
    helper="cat $(printf '%q' "$dir/ccd.key")"
    helper=${helper//\\/\\\\}
    helper=${helper//\"/\\\"}
    settings="{\"apiKeyHelper\":\"$helper\""

    # Claude Code's own gateway discovery keeps only IDs containing "claude" or "anthropic", so
    # ccd lists the server's models in /model itself. Refreshed each start; the last good list
    # is the fallback.
    # ccd.models starts with the URL it came from, so a list from another server is ignored.
    url="${ANTHROPIC_BASE_URL:-}"
    if [[ -n "$url" ]] && command -v curl >/dev/null &&
        list_models "$url" "$(<"$dir/ccd.key")" 3 2>/dev/null && [[ -n "$ids" ]]; then
        (umask 077 && printf '%s\n%s\n' "$url" "$ids" >"$dir/ccd.models")
    fi
    rows=""
    if [[ -f "$dir/ccd.models" ]] && { IFS= read -r m && [[ "$m" == "$url" ]]; } <"$dir/ccd.models"; then
        while IFS= read -r m; do
            [[ -n "$m" && ! "$m" =~ [[:cntrl:]] ]] || continue
            m=${m//\\/\\\\}
            m=${m//\"/\\\"}
            rows+="${rows:+,}{\"model\":\"$m\"}"
        done < <(tail -n +2 "$dir/ccd.models")
    fi
    if [[ -n "$rows" ]]; then
        # Built-in rows send Anthropic IDs, which another server may not accept.
        replace=true
        [[ "$url" != https://api.anthropic.com ]] || replace=false
        settings+=",\"modelPicker\":{\"replaceBuiltInOptions\":$replace,\"options\":[$rows]}"
    fi
    set -- --settings "$settings}" "$@"
fi

# shellcheck disable=SC2086
CLAUDE_CONFIG_DIR="$dir" exec claude ${CCD_ARGS:-} "$@"
